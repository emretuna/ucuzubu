# Telegram bot token (@BotFather'dan alınır)
TELEGRAM_BOT_TOKEN=

# --- Affiliate link şablonları ---
# HB Link Gelir / TY Influencer / n11 Influencer:
# Panelde bir ürün linki oluşturup şablonu buraya yapıştırın;
# şablon içinde ürün URL'sinin geleceği yere {url} yazın.
# Örnek: https://app.hb.biz/xxxx?redirect={url}
# Şablon yoksa boş bırakın → bot temiz (affiliate'siz) link gönderir.
AFFILIATE_HEPSIBURADA=
AFFILIATE_TRENDYOL=
AFFILIATE_N11=

# Amazon.com.tr Gelir Ortaklığı tag'i (ör. mytag-21).
# Boş bırakılırsa linkler tagsiz gönderilir.
AFFILIATE_AMAZON_TAG=

# SQLite veritabanı dosyası (varsayılan: ucuzu.db)
UCUZU_DB_PATH=ucuzu.db